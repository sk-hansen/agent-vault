#!/usr/bin/env python3
"""List agent-vault secrets (names + modified time) as JSON — never the values.

Reads `secret-tool search --all --unlock vault agent` output (which goes to
stderr) and drops every `secret =` line before parsing, so values cannot leak
into the panel.
"""
import json
import subprocess
import sys

try:
    out = subprocess.run(
        ["secret-tool", "search", "--all", "--unlock", "vault", "agent"],
        capture_output=True, text=True, timeout=10,
    )
except Exception as e:  # noqa: BLE001
    print(json.dumps({"secrets": [], "error": str(e)}))
    sys.exit(0)

secrets = []
current = {}
# Items are separated by "[/N]" header lines; fields are "key = value".
for line in (out.stdout + "\n" + out.stderr + "\n[end]").splitlines():
    if line.startswith("["):
        if current.get("name"):
            secrets.append(current)
        current = {}
        continue
    if line.startswith("secret ="):
        continue
    if " = " in line:
        key, _, value = line.partition(" = ")
        key = key.strip()
        if key == "attribute.name":
            current["name"] = value
        elif key == "modified":
            current["modified"] = value

secrets.sort(key=lambda s: s["name"])
print(json.dumps({"secrets": secrets, "error": "secret-tool failed" if out.returncode else None}))
