#!/usr/bin/env python3
"""List agent-vault secrets (names + modified time) as JSON — never the values.

secret-tool splits its output across streams (item headers/labels/dates on
stdout, attribute lines on stderr), so item boundaries survive only within
stdout. We therefore parse stdout alone and take each item's name from its
`label = agent-vault: <name>` line; `secret =` lines are dropped so values
cannot leak into the panel.
"""
import json
import subprocess
import sys

try:
    out = subprocess.run(
        ["secret-tool", "search", "--all", "--unlock", "vault", "agent"],
        capture_output=True, text=True, timeout=10,
    )
except Exception as e:  # noqa: BLE001
    print(json.dumps({"secrets": [], "error": str(e)}))
    sys.exit(0)

secrets = []
current = {}
# Items are separated by "[/N]" header lines; fields are "key = value".
for line in (out.stdout + "\n[end]").splitlines():
    if line.startswith("["):
        if current.get("name"):
            secrets.append(current)
        current = {}
        continue
    if line.startswith("secret ="):
        continue
    if " = " in line:
        key, _, value = line.partition(" = ")
        key = key.strip()
        if key == "label" and value.startswith("agent-vault: "):
            current["name"] = value[len("agent-vault: "):]
        elif key == "modified":
            current["modified"] = value

secrets.sort(key=lambda s: s["name"])
print(json.dumps({"secrets": secrets, "error": "secret-tool failed" if out.returncode else None}))
